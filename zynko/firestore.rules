rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Student collection rules
    match /students/{userId} {
      // Allow reading name field for all authenticated users
      allow read: if request.auth != null;
      
      // Allow create/update if it's the user's own document
      allow create, update: if request.auth != null 
        && request.auth.uid == userId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.board is string
        && request.resource.data.board == 'state'
        && request.resource.data.class in ['6', '7', '8', '9', '10', '11', '12']
        && request.resource.data.createdAt is timestamp;
      
      allow delete: if false;
    }
    
    // Community collection rules
    match /communities/{communityId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.subject in ['English', 'Tamil', 'Maths', 'Science', 'Social']
        && request.resource.data.description is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.members is list;
      allow delete: if request.auth != null 
        && request.auth.uid == resource.data.createdBy;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && (
          // Allow adding self to members
          request.resource.data.members.hasAll(resource.data.members)
          || 
          // Allow removing self from members
          resource.data.members.hasAll(request.resource.data.members)
        )
        && (
          // Only allow adding/removing the current user
          request.resource.data.members.removeAll(resource.data.members) == [request.auth.uid]
          ||
          resource.data.members.removeAll(request.resource.data.members) == [request.auth.uid]
        );

      // Messages subcollection rules
      match /messages/{messageId} {
        allow read: if request.auth != null && 
          exists(/databases/$(database)/documents/communities/$(communityId)) &&
          get(/databases/$(database)/documents/communities/$(communityId)).data.members.hasAny([request.auth.uid]);
        
        allow create: if request.auth != null && 
          exists(/databases/$(database)/documents/communities/$(communityId)) &&
          get(/databases/$(database)/documents/communities/$(communityId)).data.members.hasAny([request.auth.uid]) &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.keys().hasAll(['content', 'senderId', 'senderName', 'timestamp']);
        
        allow update: if request.auth != null &&
          exists(/databases/$(database)/documents/communities/$(communityId)) &&
          get(/databases/$(database)/documents/communities/$(communityId)).data.members.hasAny([request.auth.uid]) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']);
        
        allow delete: if request.auth != null && (
          resource.data.senderId == request.auth.uid ||
          get(/databases/$(database)/documents/communities/$(communityId)).data.createdBy == request.auth.uid
        );
      }

      // Typing subcollection rules
      match /typing/{userId} {
        allow read: if request.auth != null && 
          get(/databases/$(database)/documents/communities/$(communityId)).data.members.hasAny([request.auth.uid]);
        allow write: if request.auth != null && 
          request.auth.uid == userId &&
          get(/databases/$(database)/documents/communities/$(communityId)).data.members.hasAny([request.auth.uid]);
      }
    }
    
    // Community messages rules
    match /communities/{communityId}/messages/{messageId} {
      allow read: if request.auth != null && 
        exists(/databases/$(database)/documents/communities/$(communityId)) &&
        get(/databases/$(database)/documents/communities/$(communityId)).data.members.hasAny([request.auth.uid]);
      
      allow create: if request.auth != null &&
        exists(/databases/$(database)/documents/communities/$(communityId)) &&
        get(/databases/$(database)/documents/communities/$(communityId)).data.members.hasAny([request.auth.uid]) &&
        request.resource.data.senderId == request.auth.uid &&
        request.resource.data.content is string &&
        request.resource.data.timestamp is timestamp;
      
      allow delete: if request.auth != null &&
        (
          request.auth.uid == resource.data.senderId ||
          request.auth.uid == get(/databases/$(database)/documents/communities/$(communityId)).data.createdBy
        );
    }

    // Online status rules
    match /status/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
} 